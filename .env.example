# ==========================================
# FLAG-TAG MULTIPLAYER CONFIGURATION TEMPLATE
# ==========================================

# --- SERVER CONFIGURATION ---
# Port for the Node.js / Socket.IO server (defaults to 3001)
PORT=3001

# Allowed frontend origins for CORS (comma-separated or * for development)
# Local: http://localhost:3000
# Production: https://your-flag-tag.vercel.app
CORS_ORIGIN=*

# --- CLIENT CONFIGURATION (For Vercel / Netlify Frontend Build) ---
# Target WebSocket server URL.
# Local development: leave blank or set to http://localhost:3001
# Production: set to your deployed backend URL, e.g. https://flag-tag-server.onrender.com
VITE_SERVER_URL=
